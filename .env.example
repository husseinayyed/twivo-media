# Redis / queue
REDIS_PASS=change-me
REDIS_URL=redis://:change-me@redis:6379/0

# MongoDB
MONGODB_URL=mongodb://mongodb:27017
MONGODB_USER=twivo
MONGODB_PASSWORD=change-me

# Image pipeline
IMGPROXY_URL=http://imgproxy:8080
WEED_FILER_URL=http://weed-filer:8888

# JWT validation
JWT_ISS=twivo
JWT_AUD=media
PUBLIC_KEY_PATH=/app/keys/public.pem

# Gin runtime mode (debug, release, test)
GIN_MODE=debug

# Notes:
# - The API fails at startup if REDIS_URL, MONGODB_URL, MONGODB_USER,
#   MONGODB_PASSWORD, IMGPROXY_URL, WEED_FILER_URL, JWT_ISS, JWT_AUD,
#   or PUBLIC_KEY_PATH are empty.
# - In local Docker development, keep PUBLIC_KEY_PATH aligned with the
#   mounted key path used by the container.
